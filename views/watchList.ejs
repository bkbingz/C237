<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Watchlist</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Movie App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/movieList">Movie List</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/addMovie">Add New Movie</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Watchlist Content -->
  <div class="container">
    <h2 class="mt-4">Watchlist</h2>
    <% if (watchlist.length === 0) { %>
      <p>Your watchlist is empty.</p>
    <% } else { %>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>Movie</th>
            <th>Image</th>
            <th>Rating</th>
            <th>Review</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < watchlist.length; i++) { %>
            <tr>
              <td><%= watchlist[i].name %></td>
              <td><img src="/images/<%= watchlist[i].image %>" width="80" class="img-thumbnail"></td>
              <td><%= watchlist[i].rating %></td>
              <td><%= watchlist[i].review %></td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <div class="mt-4">
        <a href="/movieList" class="btn btn-secondary">Back to Movie List</a>
      </div>
    <% } %>
  </div>
</body>
</html>
