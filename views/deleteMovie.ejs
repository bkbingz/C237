<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Delete Movie</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <div class="card p-4">
      <h3 class="text-danger">Delete Movie</h3>
      <p>Delete movie? <strong><%= movie.name %></strong>?</p>

      <% if (movie.imagePath) { %>
        <img src="<%= movie.imagePath %>" alt="Movie Poster" class="img-fluid mb-3" style="max-height: 300px;">
      <% } %>

      <form action="/deleteMovie/<%= movie._id %>" method="POST">
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
          <a href="/movies" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
