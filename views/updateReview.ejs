<div class="container mt-4">
  <h2 class="text-center mb-4">Update Review Details</h2>
  
  <% if (review) { %>
    <form action="/updateReview/<%= review.reviewId %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 500px;">
      
      <div class="mb-3">
        <label for="name" class="form-label">Review Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= review.reviewName %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Current Image</label>
        <input type="text" class="form-control" name="currentImage" value="<%= review.image %>" readonly>
        <img src="/images/<%= review.image %>" class="img-thumbnail mt-2" style="width: 150px;">
      </div>

      <div class="mb-4">
        <label for="image" class="form-label">Upload New Image</label>
        <input class="form-control" type="file" id="image" name="image" accept="image/*">
      </div>

      <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary">Update Review</button>
        <a href="/home" class="btn btn-secondary">Back to Home</a>
      </div>
    </form>
  <% } else { %>
    <p class="text-center">No Review found.</p>
  <% } %>
</div>
