<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Review</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-4">
    <h2 class="mb-3">Review for: <%= movie.name %></h2>

    <div class="mb-3">
      <strong>Genre:</strong> <%= movie.genre %><br>
      <strong>Rating:</strong> <%= movie.rating %>/5<br>
      <strong>Description:</strong> <%= movie.description %><br>
      <% if (movie.imagePath) { %>
        <img src="<%= movie.imagePath %>" alt="Movie Poster" class="img-fluid mt-2" style="max-height: 300px;">
      <% } %>
    </div>

    <form action="/addReview/<%= movie._id %>" method="POST">

      <div class="mb-3">
        <label for="review" class="form-label">Your Review</label>
        <textarea class="form-control" id="review" name="review" rows="5" required></textarea>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Submit Review</button>
      </div>
    </form>
  </div>
</body>
</html>
