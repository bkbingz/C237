<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Movie App</title>
</head>
<body>
     <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Movie App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/movieList">Movie List</a>
          </li> 
          <li class="nav-item">
            <a class="nav-link" href="/addMovie">Add New Movie</a>
          </li> 
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <div class="container">
    <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
    <br>
    <div class="text-center"><h2>Movies</h2></div>
    <br>
    <table class="table table-hover small text-center">
      <thead>
          <tr>
            <th width="100">Movie Name</th>
            <th width="100">Movie Image</th>
            <th width="50">Rating</th>
            <th width="50">Review</th>
            <th width="50">Add Review</th>
            <th width="50">Add to watchlist</th>
          </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < movies.length; i++) { %>
          <tr>
            <td><a href="/movie/<%= movies[i].movieId %>" ><%= movies[i].name %></a></td>
            <td><img src = "images/<%= movies[i].image %>" width="20%"></td>
            <td><%= movies[i].rating %></td>
            <td>$<%= movies[i].review %></td>
          
            <!-- Buy Link -->
          <td><a href="/review/<%#= movies[i].movieId %>" class="btn btn-primary mt-3">Review</a></td> 
            

            <td>
                <form action="/watchlist/<%= movies[i].movieId %>" method="POST">
                  <input type="hidden" name="rating" id=rating-<%= movies[i].movieId %>" value="1">
                  <button type="submit" class="btn btn-primary mt-3">Watchlist</button>
                </form>
            </td>

          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>

